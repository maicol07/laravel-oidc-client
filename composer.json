{
    "name": "maicol07/laravel-oidc-client",
    "type": "library",
    "description": "OpenID Connect Client for Laravel",
    "keywords": ["laravel", "openid", "oidc", "oauth2", "authentication", "sso"],
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "maicol07/oidc-client": "^4",
        "laravel/framework": ">=11"
    },
    "require-dev": {
        "laravel/pint": "^1",
        "laravel/octane": "^2",
        "roave/security-advisories": "dev-latest",
        "rector/rector": "^1",
        "orchestra/testbench": "^11.1"
    },
    "authors": [
        {
            "name": "Cabinet Office Digital Development",
            "email": "webmaster@cabinetoffice.gov.uk",
            "role": "Creator"
        },
        {
            "name": "Maicol Battistini",
            "email": "webmaster@maicol07.it",
            "homepage": "https://maicol07.it",
            "role": "Maintainer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Maicol07\\OIDCClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maicol07\\OIDCClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maicol07\\OIDCClient\\OIDCServiceProvider"
            ]
        }
    }
}
